{
  "name": "aqtobe-bookclub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run db:generate && next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate --schema prisma/schema.local.prisma && prisma generate --schema prisma/schema.prisma",
    "db:push": "prisma db push --schema prisma/schema.local.prisma",
    "db:push:production": "node scripts/push-production-schema.mjs",
    "db:migrate:supabase": "node scripts/migrate-local-to-supabase.mjs",
    "db:studio": "prisma studio --schema prisma/schema.local.prisma"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/client": "^6.19.3",
    "next": "16.3.8",
    "next-auth": "^5.0.0-beta.32",
    "prisma": "^6.19.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "unrs-resolver@1.12.2": true
  }
}
